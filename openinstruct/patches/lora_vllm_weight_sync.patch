+class _NamedParamsView:
+    """Minimal named_parameters()/parameters() view over a fixed (name, Parameter) list, for
+    broadcast_weights_to_vllm's PEFT branch (see PolicyTrainerRayProcess.broadcast_to_vllm)."""
+
+    def __init__(self, named_params: list[tuple[str, torch.nn.Parameter]]):
+        self._named_params = named_params
+
+    def named_parameters(self):
+        return iter(self._named_params)
+
+    def parameters(self):
+        return (p for _, p in self._named_params)
